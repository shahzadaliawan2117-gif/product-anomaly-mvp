# Product-Aware Image QA - production configuration
# Copy to .env for local use, or configure these as Railway environment variables.
# Defaults below preserve the client-approved prototype behavior.

MAX_IMAGE_BYTES=15728640
REQUEST_TIMEOUT_SECONDS=10

MIN_RESOLUTION_SIDE=480
TARGET_RESOLUTION_SIDE=1200

BLUR_BAD_LAPLACIAN=45.0
BLUR_GOOD_LAPLACIAN=220.0

LOW_QUALITY_THRESHOLD=55.0
VALID_THRESHOLD=70.0
PRODUCT_MATCH_THRESHOLD=58.0
STRONG_MISMATCH_THRESHOLD=35.0

# Scoring weights must total exactly 1.0.
WEIGHT_IMAGE_QUALITY=0.20
WEIGHT_SHARPNESS=0.14
WEIGHT_RESOLUTION=0.10
WEIGHT_VISIBILITY=0.14
WEIGHT_COMPOSITION=0.10
WEIGHT_BACKGROUND=0.08
WEIGHT_LIGHTING=0.10
WEIGHT_TEXT_READABILITY=0.14
